# ==========================================
# Snaxio - Monorepo Root .gitignore
# Frontend + Node.js Microservices
# ==========================================

# ------------------------------------------
# Environment / Secrets
# ------------------------------------------

.env
.env.*
!.env.example
!.env.template

# Environment files anywhere inside the monorepo
**/.env
**/.env.*
!**/.env.example
!**/.env.template

# Local secrets / credentials
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore

# Google / Firebase / OAuth credentials
service-account*.json
*-service-account.json
firebase-adminsdk*.json
google-credentials*.json
credentials.json
secrets.json

# ------------------------------------------
# Node.js
# ------------------------------------------

node_modules/
**/node_modules/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/
.pnpm-store/

# ------------------------------------------
# Build / Distribution
# ------------------------------------------

dist/
**/dist/

build/
**/build/

out/
**/out/

coverage/
**/coverage/

.tmp/
temp/
tmp/

# ------------------------------------------
# TypeScript
# ------------------------------------------

*.tsbuildinfo

# Source maps
*.js.map
*.css.map

# ------------------------------------------
# Frontend Frameworks
# ------------------------------------------

# Angular
.angular/
.cache/
**/.angular/

# React / Vite / Next.js
.next/
.nuxt/
.svelte-kit/

# ------------------------------------------
# Logs
# ------------------------------------------

logs/
*.log

# ------------------------------------------
# IDE / Editors
# ------------------------------------------

.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

.idea/
*.iml
*.iws
*.ipr

# ------------------------------------------
# OS generated files
# ------------------------------------------

.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------
# Local development databases
# ------------------------------------------

*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Docker local overrides
# ------------------------------------------

docker-compose.override.yml
docker-compose.local.yml

# ------------------------------------------
# Test / Temporary files
# ------------------------------------------

.nyc_output/
test-results/
playwright-report/
test-results/

*.tmp
*.temp

# ------------------------------------------
# Generated certificates / local SSL
# ------------------------------------------

certificates/
certs/
ssl/

# ------------------------------------------
# Local configuration
# ------------------------------------------

config.local.*
config.*.local.*

# ------------------------------------------
# OS / editor backups
# ------------------------------------------

*.swp
*.swo
*~
*.bak
*.orig

# ------------------------------------------
# Package manager lock files
# ------------------------------------------
# IMPORTANT:
# Do NOT ignore package-lock.json / yarn.lock / pnpm-lock.yaml.
# Lock files SHOULD be committed.

# ------------------------------------------
# Local deployment files
# ------------------------------------------

.vercel/
.netlify/

# ------------------------------------------
# Miscellaneous
# ------------------------------------------

.Dockerfile.local
*.local.json
*.local.yaml
*.local.yml